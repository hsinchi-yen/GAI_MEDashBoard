<?xml version="1.0" encoding="utf-8"?>
<!-- All external API endpoints (FRED, DBnomics, OECD) use HTTPS; cleartext disabled -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
